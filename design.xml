<design-system version="1.0">

  <brand>
    <name>Enterprise Bitcoin Design System</name>
    <style>
      Premium dark fintech SaaS interface
      with Bitcoin DeFi identity.
    </style>
  </brand>

  <colors>
    <background>#030304</background>
    <surface>#0F1115</surface>
    <surface-elevated>#171A20</surface-elevated>
    <primary>#F7931A</primary>
    <secondary>#EA580C</secondary>
    <gold>#FFD600</gold>
    <text>#FFFFFF</text>
    <muted>#94A3B8</muted>
  </colors>

  <typography>
    <headings>Space Grotesk</headings>
    <body>Inter</body>
    <technical>JetBrains Mono</technical>
  </typography>

  <layout>
    <grid>12 columns desktop</grid>
    <spacing>8 point system</spacing>
    <radius>
      16px cards
      999px buttons
    </radius>
  </layout>

  <rules>
    Use reusable components.
    Use design tokens.
    Maintain accessibility.
    Mobile first.
    Never hardcode values.
  </rules>

  <documentation>
    Full system: docs/design_v1/ (files 01–50)
    Tokens: docs/design_v1/design-tokens.json
    SCSS: docs/design_v1/variables.scss
    Tailwind: docs/design_v1/tailwind.config.js
  </documentation>

</design-system>
